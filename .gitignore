# Cache de Python
__pycache__/
*.pyc

# Entornos virtuales
.venv/
venv/

# Resultados generados al ejecutar.
# Los ejemplos que si se publican viven en ejemplos/
/*.xlsx

# Datos de origen: el censo del Ayuntamiento son 125 MB y GitHub rechaza
